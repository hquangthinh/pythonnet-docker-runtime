<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>SplinkSmoke.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- pythonnet 3.1.0 is the first stable release that supports Python 3.14. -->
    <PackageReference Include="pythonnet" Version="3.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the custom Python module next to the app so PythonEngineHost can add it to sys.path. -->
    <None Include="python_modules\**\*.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
